{
	"schemaVersion": 1,
	"id": "jailmod",
	"version": "${version}",
	"name": "Jail Mod",
	"description": "A server-side (and singleplayer) mod that allows administrators to jail players with time-based sentences and restrictions.",
	"authors": [
		"n3mmos",
		"Abdo9616"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/ZJf231gD",
		"sources": "https://github.com/Abdo9616/jail-mod",
		"issues": "https://github.com/Abdo9616/jail-mod/issues"
	},
	"license": "MIT",
	"icon": "assets/jailmod/icon.png",
	"environment": "*",
