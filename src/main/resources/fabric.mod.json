	},
	"custom": {
		"modmenu": {
			 "links": {
        "modmenu.modrinth": "https://modrinth.com/project/ZJf231gD",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/jail-logic-unofficial-update"
            },
			"update_checker": true
		}
