		"main": [
			"com.example.jailmod.JailMod"
		],
		"modmenu": [
			"com.example.jailmod.client.modmenu.JailModMenuIntegration"
		]
	},
	"mixins": [
		"jailmod.mixins.json"
	],
	"depends": {
